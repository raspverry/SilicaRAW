{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SilicaRAW",
  "version": "0.1.0",
  "identifier": "dev.silicaraw.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SilicaRAW",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Photography",
    "shortDescription": "Local-first RAW editor packaging spike.",
    "longDescription": "SilicaRAW local desktop shell for validating macOS app and DMG packaging.",
    "copyright": "Copyright 2026 SilicaRAW contributors. Licensed under MIT.",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
