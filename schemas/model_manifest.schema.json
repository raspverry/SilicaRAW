{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicaraw.local/schemas/model_manifest.schema.json",
  "title": "SilicaRAW MLX Model Manifest v0.1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "model_id",
    "model_version",
    "task_type",
    "license",
    "source",
    "file_hash",
    "input",
    "output",
    "minimum_silica_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "silica.model"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "model_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "subject_mask",
        "sky_mask",
        "blur_score",
        "quality_score",
        "duplicate_grouping",
        "auto_tone",
        "denoise",
        "upscale"
      ]
    },
    "license": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "file_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input": {
      "type": "object",
      "required": [
        "preprocessing"
      ],
      "properties": {
        "preprocessing": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "metadata"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "minimum_silica_version": {
      "type": "string"
    }
  }
}
