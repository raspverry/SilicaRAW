{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicaraw.local/schemas/plugin_manifest.schema.json",
  "title": "SilicaRAW Plugin Manifest v0.1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "plugin_id",
    "name",
    "description",
    "author",
    "license",
    "plugin_version",
    "minimum_silica_version",
    "type",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "silica.plugin"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1
    },
    "minimum_silica_version": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "preset_pack",
        "export_preset",
        "ai_model",
        "workflow"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "metadata:read",
          "edit_suggestion:read",
          "edit_suggestion:apply",
          "export:local",
          "filesystem:limited_read",
          "ai_result:read"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
